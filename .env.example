# CivicEye environment variables
# Copy this file to .env and fill in real values before running

DJANGO_SECRET_KEY=replace-this-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Email (leave blank to keep the console backend which just prints to terminal)
